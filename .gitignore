# ===========================================
# FlyNG .gitignore
# ===========================================

# ===========================================
# Environment & Secrets
# ===========================================
.env
.env.local
.env.*.local
*.env
!.env.example

# ===========================================
# Python
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv/

# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ===========================================
# Node.js / Frontend
# ===========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
frontend/dist/
frontend/build/
*.local

# ===========================================
# IDE & Editors
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ===========================================
# OS Files
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===========================================
# Django
# ===========================================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
backend/media/
backend/staticfiles/
backend/static/
backend/logs/

# Migrations - keep in version control
# backend/apps/*/migrations/0*.py
# !backend/apps/*/migrations/__init__.py

# ===========================================
# Docker
# ===========================================
*.log

# ===========================================
# Testing
# ===========================================
coverage/
.nyc_output/

# ===========================================
# Misc
# ===========================================
*.bak
*.tmp
*.temp
.cache/
