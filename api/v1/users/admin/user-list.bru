meta {
  name: User List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users/?page=1&page_size=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

query {
  page: 1
  page_size: 10
  ~search: john
  ~role: operator
  ~is_active: true
}

docs {
  # List Users (Admin/Manager Only)

  Returns paginated list of users.

  ## Query Parameters
  - `page` (optional): Page number (default: 1)
  - `page_size` (optional): Items per page (default: 10, max: 100)
  - `search` (optional): Search by name or email
  - `role` (optional): Filter by role (admin, manager, operator, viewer)
  - `is_active` (optional): Filter by active status

  ## Response
  - 200: Paginated user list
  - 403: Not authorized (requires admin or manager role)
  - 401: Not authenticated
}
