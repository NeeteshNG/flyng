meta {
  name: User Detail
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/users/:uuid/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:path {
  uuid: user-uuid-here
}

docs {
  # Get User Detail (Admin/Manager Only)

  Returns detailed information about a specific user.

  ## Path Parameters
  - `uuid`: User's UUID

  ## Response
  - 200: User detail object
  - 403: Not authorized
  - 404: User not found
  - 401: Not authenticated
}
