meta {
  name: Force Password Change
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/users/:uuid/force-password-change/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:path {
  uuid: user-uuid-here
}

docs {
  # Force Password Change (Admin Only)

  Forces a user to change their password on next login.

  ## Path Parameters
  - `uuid`: User's UUID

  ## Response
  - 200: Password change required flag set
  - 403: Not authorized (admin only)
  - 404: User not found
  - 401: Not authenticated

  ## Behavior
  User will be prompted to change password immediately after next successful login.
}
