meta {
  name: Reset Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users/reset-password/
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "reset_token": "token-from-verify-otp",
    "new_password": "NewSecurePass123!",
    "new_password_confirm": "NewSecurePass123!"
  }
}

docs {
  # Reset Password

  Resets password using the token from OTP verification.

  ## Flow
  1. Call Send OTP with `otp_type: "password_reset"`
  2. Call Verify OTP to get `reset_token`
  3. Call this endpoint with the token

  ## Request Body
  - `email` (required): User's email
  - `reset_token` (required): Token from Verify OTP response
  - `new_password` (required): New password
  - `new_password_confirm` (required): Must match new_password

  ## Response
  - 200: Password reset successfully
  - 400: Invalid token or validation error
}
