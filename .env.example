# ===========================================
# FlyNG Environment Configuration
# ===========================================
# Copy this file to .env and update the values

# ===========================================
# Django Settings
# ===========================================
DEBUG=True
# Options: development, production
DJANGO_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# Database (PostgreSQL)
# ===========================================
POSTGRES_DB=flyng
POSTGRES_USER=flyng
POSTGRES_PASSWORD=flyng_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# Ports
# ===========================================
BACKEND_PORT=8002

# ===========================================
# CORS Settings
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8002

# ===========================================
# Frontend
# ===========================================
VITE_API_BASE_URL=http://localhost:8002/api/v1

# ===========================================
# Email Configuration (Optional)
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@flyng.in

# ===========================================
# Superuser (Development)
# ===========================================
CREATE_SUPERUSER=true
SUPERUSER_EMAIL=admin@flyng.local
SUPERUSER_PASSWORD=admin123

# ===========================================
# Production Only
# ===========================================
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# SENTRY_DSN=your-sentry-dsn
