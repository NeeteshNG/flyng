# ===========================================
# FlyNG Production Environment Configuration
# ===========================================
# Copy this file to .env.prod and update with secure values
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ===========================================
# Django Settings
# ===========================================
DEBUG=False
DJANGO_ENV=production
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secure-production-secret-key-here

# ===========================================
# Hosts & Origins
# ===========================================
# Comma-separated list of allowed hosts
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===========================================
# Database (PostgreSQL)
# ===========================================
POSTGRES_DB=flyng_prod
POSTGRES_USER=flyng_prod
# Use a strong password!
POSTGRES_PASSWORD=your-secure-database-password

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# Frontend
# ===========================================
VITE_API_BASE_URL=https://yourdomain.com/api/v1

# ===========================================
# Email Configuration
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# Monitoring (Optional)
# ===========================================
# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
